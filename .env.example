# Backend accepts browser requests from these origins.
FRONTEND_ORIGIN=http://localhost:3000,https://icebraking-frontend.vercel.app

# Backend port.
PORT=4000

# Recommended for production concurrency.
# Create an Upstash Redis database and set these in your deploy platform.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Recommended for a production admin-only reset endpoint.
ADMIN_TOKEN=
