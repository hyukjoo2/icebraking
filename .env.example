# Frontend calls this URL from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Backend accepts browser requests from this origin.
FRONTEND_ORIGIN=http://localhost:3000

# Backend port.
PORT=4000

# Recommended for production concurrency.
# Create an Upstash Redis database and set these in your deploy platform.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# One meeting room/session. Change per monthly meeting when needed.
ICEBREAKING_SESSION_ID=monthly-2026-09

# Default is 6 hours.
ICEBREAKING_SESSION_TTL_SECONDS=21600

# Recommended for a production admin-only reset endpoint.
ADMIN_TOKEN=
